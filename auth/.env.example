# ABC Financial API (needed by /reports/deactivated-pt, ptNewClients, ptHealth,
# ptRoster, and the scripts/abc-employee-roster.js one-off generator).
# Copy values from Render → wcs-auth-api → Environment.
ABC_BASE_URL=https://api.abcfinancial.com/rest
ABC_APP_ID=
ABC_APP_KEY=

# WCS University enrollment (admin "Enroll" button). Ships dark behind
# UNIVERSITY_ENROLL_ENABLED (in addition to UNIVERSITY_ENABLED). The University
# token is a LOCATION-level private integration on the University sub-account
# and must carry scopes: contacts.readonly/write, users.readonly/write,
# locations/customFields.readonly. See services/university/README.md.
UNIVERSITY_ENROLL_ENABLED=false
GHL_UNIVERSITY_LOCATION_ID=
GHL_UNIVERSITY_API_KEY=
# Enroll only creates + assigns the practice contacts. Adding the user to the
# University sub-account and setting their permissions is done by hand in GHL.

# Media Library visual search (search API lives here in auth)
VOYAGE_API_KEY=
# Used by POST /media/reindex to trigger the ghl-sync indexer worker.
GHL_SYNC_URL=
SYNC_SECRET=

# Weekly Operandio KPI digest (auth/src/services/kpiDigest). Publishes a
# knowledge article every Monday 8am PT with the prior Mon–Sun sales + Day One
# numbers. Reuses OPERANDIO_API_EMAIL / OPERANDIO_API_PASSWORD (Operandio
# GraphQL) and the Supabase service-role client. Cron is opt-in:
OPERANDIO_KPI_DIGEST_ENABLED=false

# Meeting notes automation (auth/src/services/meetingNotes). Polls ClickUp for
# each recurring meeting's notetaker Doc, publishes a Google Doc of the notes
# (attached to that day's calendar event), and generates AI prep notes for next
# week's meeting (attached to next week's event). Reuses CLICKUP_API_KEY, the
# per-staff Google token (GOOGLE_BUSINESS_CLIENT_ID/SECRET + staff_google_tokens),
# and ANTHROPIC_API_KEY. The owner must connect Google via /meeting-notes with
# the Documents + Calendar scopes (see routes/meetingNotes). Cron opt-in:
MEETING_NOTES_ENABLED=false
# Google account that owns the Docs and whose calendar holds the meeting events:
MEETING_NOTES_GOOGLE_EMAIL=justin@wcstrength.com
# Which calendar to search (default primary):
MEETING_NOTES_CALENDAR_ID=primary
# Docs land in a Drive folder the job auto-creates + reuses by name. Override
# the name, or pin a specific app-created folder id, if you want:
MEETING_NOTES_DRIVE_FOLDER_NAME=Meeting Notes
MEETING_NOTES_DRIVE_FOLDER_ID=
# Optional overrides: CLICKUP_WORKSPACE_ID (default WCS), MEETING_NOTES_CRON.

# Ticket -> Google Chat bridge (auth/src/services/googleChat + ticketNotify).
# When a staff member assigns a ticket or @mentions someone in a ticket comment,
# the target gets a Google Chat DM sent AS the actor, using the actor's own
# per-staff Google OAuth token (staff_google_tokens) — no bot, no domain-wide
# delegation. The actor connects Google Chat once via /google-chat (adds the
# chat.spaces + chat.messages scopes on top of any Sheets/Docs scopes).
# One-time Google Cloud setup: enable the Google Chat API on the OAuth project,
# add those two scopes to the consent screen, and register
# <AUTH_API_URL>/google-chat/callback as an authorized redirect URI. Reuses
# GOOGLE_BUSINESS_CLIENT_ID / GOOGLE_BUSINESS_CLIENT_SECRET.
# PORTAL_BASE_URL is the deep-link host used in the DM copy (falls back to
# PORTAL_URL, then the app default):
PORTAL_BASE_URL=https://app.westcoaststrength.com
