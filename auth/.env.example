# ABC Financial API (needed by /reports/deactivated-pt, ptNewClients, ptHealth,
# ptRoster, and the scripts/abc-employee-roster.js one-off generator).
# Copy values from Render → wcs-auth-api → Environment.
ABC_BASE_URL=https://api.abcfinancial.com/rest
ABC_APP_ID=
ABC_APP_KEY=

# WCS University enrollment (admin "Enroll" button). Ships dark behind
# UNIVERSITY_ENROLL_ENABLED (in addition to UNIVERSITY_ENABLED). The University
# token is a LOCATION-level private integration on the University sub-account
# and must carry scopes: contacts.readonly/write, users.readonly/write,
# locations/customFields.readonly. See services/university/README.md.
UNIVERSITY_ENROLL_ENABLED=false
GHL_UNIVERSITY_LOCATION_ID=
GHL_UNIVERSITY_API_KEY=
# Enroll only creates + assigns the practice contacts. Adding the user to the
# University sub-account and setting their permissions is done by hand in GHL.

# Media Library visual search (search API lives here in auth)
VOYAGE_API_KEY=
# Used by POST /media/reindex to trigger the ghl-sync indexer worker.
GHL_SYNC_URL=
SYNC_SECRET=
