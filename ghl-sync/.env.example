# GHL
GHL_BASE_URL=https://services.leadconnectorhq.com

# GHL Sub-account Location IDs
GHL_LOCATION_SALEM=
GHL_LOCATION_KEIZER=
GHL_LOCATION_EUGENE=
GHL_LOCATION_SPRINGFIELD=
GHL_LOCATION_CLACKAMAS=
GHL_LOCATION_MILWAUKIE=
GHL_LOCATION_MEDFORD=

# GHL Per-location API Keys (Private Integration Tokens)
GHL_API_KEY_SALEM=
GHL_API_KEY_KEIZER=
GHL_API_KEY_EUGENE=
GHL_API_KEY_SPRINGFIELD=
GHL_API_KEY_CLACKAMAS=
GHL_API_KEY_MILWAUKIE=
GHL_API_KEY_MEDFORD=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sync config
SYNC_INTERVAL_MINUTES=10
FULL_SYNC_HOUR=3
CONTACTS_PAGE_SIZE=100
OPPS_PAGE_SIZE=100
PORT=3000

# Email campaign stats sync (GHL Email V2). Interval in minutes; per-stats-call
# spacing in ms to stay under 100 req / 10s.
EMAIL_STATS_INTERVAL_MINUTES=30
EMAIL_STATS_DELAY_MS=120

# API protection
SYNC_SECRET=

# Lapsed check-in tagging (nightly). Dark-launched: off by default, and even
# when enabled defaults to dry-run (logs intended tag changes to
# abc_sync_run_log without writing to GHL). Hour is PST.
LAPSED_TAGGING_ENABLED=false
LAPSED_TAGGING_DRY_RUN=true
LAPSED_TAGGING_HOUR=5

# Alerts (GHL webhook that triggers the staff SMS workflow). Has a built-in
# default; override to point at a different webhook. Shared by ABC sync errors
# and the revenue gap check.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=360

# Revenue report gap check (daily). Alerts when a recent day has no ABC revenue
# import (a missed "Revenue by Profit Center" email). Hour is UTC.
REVENUE_GAP_CHECK_HOUR=20
REVENUE_GAP_LOOKBACK_DAYS=7

# Media Library visual search (indexer runs here in ghl-sync)
VOYAGE_API_KEY=
MEDIA_ROOT_FOLDER_ID=
MEDIA_VIDEO_FRAME_INTERVAL_SEC=5
MEDIA_INDEX_HOUR=8
# Google OAuth client used to refresh the shared Drive token in app_config.
# Must match auth service values (same Google OAuth app as GOOGLE_BUSINESS_CLIENT_ID/SECRET in auth).
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
